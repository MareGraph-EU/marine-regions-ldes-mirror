@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfl: <https://w3id.org/rdf-lens/ontology#>.
@prefix tree: <https://w3id.org/tree#>.
@prefix dct: <http://purl.org/dc/terms/>.

#########################################
### Import runners and processors
#########################################
<> owl:imports <./node_modules/@rdfc/js-runner/index.ttl>,
  <./node_modules/@rdfc/file-utils-processors-ts/processors.ttl>,
  <./node_modules/ldes-client/processor.ttl>,
  <./node_modules/@rdfc/sds-processors-ts/configs/bucketizer.ttl>,
  <./node_modules/@rdfc/sds-storage-writer-ts/processor.ttl>.

#########################################
# Channel definitions
#########################################
# Metadata channel from rdfc:GlobRead to rdfc:Bucketize
<metadata1> a rdfc:Reader, rdfc:Writer.

# Metadata channel from rdfc:Bucketize to rdfc:Ingest
<metadata2> a rdfc:Reader, rdfc:Writer.

# Data channel from rdfc:LdesClient to rdfc:Bucketize
<rawMembers> a rdfc:Reader, rdfc:Writer.

# Channel from rdfc:Bucketize to rdfc:Ingest
<bucketizedMembers> a rdfc:Reader, rdfc:Writer.

#########################################
### Define the pipeline
#########################################
<> a rdfc:Pipeline;
  rdfc:consistsOf [
    rdfc:instantiates rdfc:NodeRunner;
    rdfc:processor <globRead>, <bucketizer>, <ldesClient>, <ingestor>;
  ].

#########################################
# Processor definitions
#########################################
# File reader processor for metadata input on rdfc:Bucketize
<globRead> a rdfc:GlobRead;
  rdfc:glob "./config/sds-metadata.ttl";
  rdfc:output <metadata1>;
  rdfc:closeOnEnd "true"^^xsd:boolean.

# Processor to read member events from a LDES
<ldesClient> a rdfc:LdesClient;
  rdfc:output <rawMembers>;
  rdfc:url [
    a rdfl:EnvVariable;
    rdfl:envDefault <https://marineregions.org/feed>;
    rdfl:envKey "SOURCE_LDES_URL";
  ];
  rdfc:ordered "ascending";
  # Poll mutable fragments every 15 seconds
  rdfc:follow true;
  rdfc:interval 30000;
  rdfc:materialize false;
  rdfc:savePath "./state/ldes";
  #rdfc:after "2025-02-10T00:00:00Z"^^xsd:dateTime;
  rdfc:fetch [
    rdfc:concurrent 1;
    rdfc:retry [
      rdfc:code 408, 425, 429, 500, 502, 503, 504;
      rdfc:maxRetry 15;
    ];
  ];
  rdfc:sdsify true;
  rdfc:streamId [
    # We opt to make it the same, but this IRI may be different than the source LDES URL.
    # It is used internally to identify the stream of data we operate on.
    # It must match the IRI defined in the SDS metadata configuration.
    a rdfl:EnvVariable;
    rdfl:envDefault <https://marineregions.org/feed>;
    rdfl:envKey "SOURCE_LDES_URL";
  ].

# Processor to bucketize the data
<bucketizer> a rdfc:Bucketize;
  rdfc:channels [
    rdfc:dataInput <rawMembers>;
    rdfc:dataOutput <bucketizedMembers>;
    rdfc:metadataInput <metadata1>;
    rdfc:metadataOutput <metadata2>;
  ];
  rdfc:bucketizeStrategy ( [
    a tree:TimebasedFragmentation;
    tree:timestampPath dct:modified;
    tree:maxSize 100;
    tree:k 4;
    # 1 hour
    tree:minBucketSpan 3600;
  ] );
  rdfc:savePath "./state/bucketize-state.json";
  rdfc:outputStreamId "${LDES_MIRROR_BASE_URL}${LDES_MIRROR_URL_PATH}".

# Processor to persist the bucketized SDS stream into a data storage system
<ingestor> a rdfc:IngestSDS;
  rdfc:dataInput <bucketizedMembers>;
  rdfc:metadataInput <metadata2>;
  rdfc:database [
    a rdfc:DatabaseConfig;
    rdfc:url "${STORE_TYPE}://${STORE_URL}";
    rdfc:metadata "MR_METADATA";
    rdfc:data "MR_DATA";
    rdfc:index "MR_INDEX";
  ].

